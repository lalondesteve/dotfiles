{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "synthwave84"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "tabs": {
    "layout": "horizontal",
    "mode": "auto"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "variant": "low"
    }
  },
  "plugin": [
    "./plugins/granforge-polyscope-vision.ts"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78",
        "--browser",
        "chromium",
        "--caps=vision",
        "--image-responses",
        "allow",
        "--isolated",
        "--viewport-size=1280x720"
      ],
      "enabled": true
    }
  }
}
